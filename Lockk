local function createTransparencySlider(parent, text, settingRef, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundColor3 = Color3.fromRGB(30,30,30)
    f.BackgroundTransparency = 0.3
    f.Parent = parent
    Instance.new("UICorner").CornerRadius = UDim.new(0, 4); Instance.new("UICorner").Parent = f

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.Text = text .. ": " .. string.format("%.2f", settingRef)
    lbl.TextColor3 = Color3.fromRGB(200,200,200)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -40, 0, 10)
    bg.Position = UDim2.new(0, 20, 0, 30)
    bg.BackgroundColor3 = Color3.fromRGB(50,50,50)
    bg.BorderSizePixel = 0
    bg.Parent = f
    Instance.new("UICorner").CornerRadius = UDim.new(1, 0); Instance.new("UICorner").Parent = bg

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(settingRef, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255,255,255)
    fill.BorderSizePixel = 0
    fill.Parent = bg
    Instance.new("UICorner").CornerRadius = UDim.new(1, 0); Instance.new("UICorner").Parent = fill

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 16, 0, 16)
    btn.Position = UDim2.new(settingRef, -8, 0.5, -8)
    btn.BackgroundColor3 = Color3.fromRGB(255,255,255)
    btn.Text = ""
    btn.Parent = bg
    Instance.new("UICorner").CornerRadius = UDim.new(1, 0); Instance.new("UICorner").Parent = btn

    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = UserInputService:GetMouseLocation()
            local pos = bg.AbsolutePosition
            local size = bg.AbsoluteSize.X
            local rel = math.clamp((mousePos.X - pos.X) / size, 0, 1)
            if math.abs(rel - settingRef) > 0.005 then
                settingRef = rel
                fill.Size = UDim2.new(settingRef, 0, 1, 0)
                btn.Position = UDim2.new(settingRef, -8, 0.5, -8)
                lbl.Text = text .. ": " .. string.format("%.2f", settingRef)
                if callback then callback(settingRef) end
            end
        end
    end)
    return f
end

