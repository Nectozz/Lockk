local function resolvePendingList(list)
    for i, entry in pairs(list) do
        if isPendingPlayer(entry) then
            for _, player in pairs(Players:GetPlayers()) do
                if player.UserId == entry.UserId then
                    list[i] = player
                    break
                end
            end
        end
    end
end

-- ========== HIGHLIGHT ==========
local function ensureCharacterReady(player)
    if not player then return nil end
    local char = player.Character
    if not char then return nil end
    if not char:FindFirstChildOfClass("Humanoid") then
        local ok = pcall(function() char:WaitForChild("Humanoid", 2) end)
        if not ok then return nil end
    end
    return char
end

local function applyHighlight(player, isTarget)
    local char = ensureCharacterReady(player)
    if not char then return end

    local highlight = char:FindFirstChild(HIGHLIGHT_NAME)
    if not highlight or not highlight:IsA("Highlight") then
        if highlight then highlight:Destroy() end
        highlight = Instance.new("Highlight")
        highlight.Name = HIGHLIGHT_NAME
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = char
        highlight.Parent = char
    end

    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    if isTarget then
        highlight.OutlineColor = rgbToColor3(Settings.TargetOutlineColor)
        highlight.FillColor = rgbToColor3(Settings.TargetFillColor)
        highlight.OutlineTransparency = Settings.TargetUseOutline and Settings.TargetOutlineTransparency or 1
        highlight.FillTransparency = Settings.TargetUseFill and Settings.TargetFillTransparency or 1
        highlight.Enabled = Settings.TargetUseOutline or Settings.TargetUseFill
    else
        highlight.OutlineColor = rgbToColor3(Settings.WhitelistOutlineColor)
        highlight.FillColor = rgbToColor3(Settings.WhitelistFillColor)
        highlight.OutlineTransparency = Settings.WhitelistUseOutline and Settings.WhitelistOutlineTransparency or 1
        highlight.FillTransparency = Settings.WhitelistUseFill and Settings.WhitelistFillTransparency or 1
        highlight.Enabled = Settings.WhitelistUseOutline or Settings.WhitelistUseFill
    end
end

local function updateAllHighlights()
    for _, p in pairs(selectedPlayers) do
        if not isPendingPlayer(p) then applyHighlight(p, true) end
    end
    for _, p in pairs(whitelistPlayers) do
        if not isPendingPlayer(p) then applyHighlight(p, false) end
    end
end

local function removePlayerHighlight(player)
    if player and player.Character then
        local h = player.Character:FindFirstChild(HIGHLIGHT_NAME)
        if h then h:Destroy() end
    end
end

-- ========== DRAWING ==========
local hasDrawing = (type(Drawing) == "table" and type(Drawing.new) == "function")

local function createAimDot(player)
    if not hasDrawing then return nil end
    if aimDots[player] then return aimDots[player] end
    local dot = Drawing.new("Square")
    dot.Visible = false
    dot.Size = Vector2.new(Settings.DotSize, Settings.DotSize)
    dot.Color = rgbToColor3(Settings.HighlightColor)
    dot.Filled = true
    dot.Transparency = 1
    dot.ZIndex = 999
    aimDots[player] = dot
    return dot
end

local function removeAimDot(player)
    if aimDots[player] then
        pcall(function() aimDots[player]:Remove() end)
        aimDots[player] = nil
    end
end

local function updateAimDot(player)
    if not hasDrawing then return end
    if not player or not player.Character then return end
    local dot = aimDots[player]
    if not dot then return end
    local part = getTargetPart(player.Character)
    if not part then
        dot.Visible = false
        return
    end
    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if onScreen then
        local offset = math.floor(Settings.DotSize / 2)
        dot.Position = Vector2.new(screenPos.X - offset, screenPos.Y - offset)
        dot.Visible = true
        dot.Color = (player == currentTarget and aimLockEnabled)
            and rgbToColor3(Settings.CurrentTargetColor)
            or rgbToColor3(Settings.HighlightColor)
    else
        dot.Visible = false
    end
end

local function updateAllDotSizes()
    local size = Settings.DotSize
    for _, dot in pairs(aimDots) do
        dot.Size = Vector2.new(size, size)
    end
end

local function updateAllDotColors()
    for player, dot in pairs(aimDots) do
        dot.Color = (player == currentTarget and aimLockEnabled)
            and rgbToColor3(Settings.CurrentTargetColor)
            or rgbToColor3(Settings.HighlightColor)
    end
end

-- ========== AIM ==========
local function isWhitelisted(player)
    return isInList(whitelistPlayers, player)
end

local function hasAnyTargets()
    for _, entry in pairs(selectedPlayers) do
        if not isPendingPlayer(entry) then return true end
    end
    return false
end

-- Есть таргеты → первый живой таргет (не WL).
-- Нет таргетов → ближайший среди всех игроков, кроме WL.
local function getAimTarget()
    if hasAnyTargets() then
        for _, entry in pairs(selectedPlayers) do
            if not isPendingPlayer(entry)
                and entry ~= LocalPlayer
                and isPlayerAlive(entry)
                and not isWhitelisted(entry)
                and getTargetPart(entry.Character) then
                return entry
            end
        end
        return nil
    end

    -- фолбэк: все игроки, кроме WL
    local localChar = LocalPlayer.Character
    local localHRP = localChar and getTargetPart(localChar)
    if not localHRP then return nil end

    local localPos = localHRP.Position
    local bestDist = math.huge
    local bestPlayer = nil

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isPlayerAlive(p) and not isWhitelisted(p) then
            local part = getTargetPart(p.Character)
            if part then
                local dist = (localPos - part.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestPlayer = p
                end
            end
        end
    end
    return bestPlayer
end

