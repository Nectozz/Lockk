local function toggleWhitelist(player)
    if not player then return end

    if isInList(whitelistPlayers, player) then
        removeFromList(whitelistPlayers, player)
        removePlayerHighlight(player)
        removeAimDot(player)
        print("[WHITELIST] Убран:", player.Name)
    else
        if isInList(selectedPlayers, player) then
            removeFromList(selectedPlayers, player)
            removeAimDot(player)
            saveSelectedPlayers()
            if currentTarget == player then currentTarget = nil end
        end
        table.insert(whitelistPlayers, player)
        applyHighlight(player, false)
        print("[WHITELIST] Добавлен:", player.Name)
    end

    saveWhitelist()
    refreshPlayerList()
end

