-- ========== УТИЛИТЫ ==========
local function rgbToColor3(rgb)
    return Color3.new(rgb[1]/255, rgb[2]/255, rgb[3]/255)
end

local function parseRGBString(str)
    local r, g, b = str:match("(%d+);(%d+);(%d+)")
    if r and g and b then
        return {
            math.clamp(tonumber(r) or 0, 0, 255),
            math.clamp(tonumber(g) or 0, 0, 255),
            math.clamp(tonumber(b) or 0, 0, 255)
        }
    end
    return {255, 255, 255}
end

local function formatRGBString(rgb)
    return string.format("%d;%d;%d", rgb[1], rgb[2], rgb[3])
end

local function isPendingPlayer(entry)
    return type(entry) == "table" and entry.Pending == true
end

local function isPlayerAlive(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getTargetPart(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Head")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
end

local function isInList(list, player)
    for _, p in pairs(list) do
        if p == player then return true end
    end
    return false
end

local function removeFromList(list, player)
    for i, p in pairs(list) do
        if p == player then
            table.remove(list, i)
            return true
        end
    end
    return false
end

local function getPlayerUnderCursor()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    if not target then return nil end
    local current = target
    while current do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            local player = Players:GetPlayerFromCharacter(current)
            if player and player ~= LocalPlayer then
                return player
            end
        end
        current = current.Parent
    end
    return nil
end

-- ========== ФАЙЛЫ ==========
local function hasFileSupport()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function saveSettings()
    if not hasFileSupport() then return end
    local data = {
        DotSize = Settings.DotSize,
        TargetOutlineColor = Settings.TargetOutlineColor,
        TargetFillColor = Settings.TargetFillColor,
        TargetOutlineTransparency = Settings.TargetOutlineTransparency,
        TargetFillTransparency = Settings.TargetFillTransparency,
        TargetUseOutline = Settings.TargetUseOutline,
        TargetUseFill = Settings.TargetUseFill,
        WhitelistOutlineColor = Settings.WhitelistOutlineColor,
        WhitelistFillColor = Settings.WhitelistFillColor,
        WhitelistOutlineTransparency = Settings.WhitelistOutlineTransparency,
        WhitelistFillTransparency = Settings.WhitelistFillTransparency,
        WhitelistUseOutline = Settings.WhitelistUseOutline,
        WhitelistUseFill = Settings.WhitelistUseFill,
        HighlightColor = Settings.HighlightColor,
        CurrentTargetColor = Settings.CurrentTargetColor
    }
    pcall(function()
        writefile("AimLock_Settings_v3.txt", HttpService:JSONEncode(data))
    end)
end

local function loadSettings()
    if not hasFileSupport() then return end
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile("AimLock_Settings_v3.txt"))
    end)
    if success and type(data) == "table" then
        if data.DotSize then Settings.DotSize = math.clamp(data.DotSize, Settings.DotMinSize, Settings.DotMaxSize) end
        for _, key in ipairs({
            "TargetOutlineColor","TargetFillColor","WhitelistOutlineColor","WhitelistFillColor",
            "HighlightColor","CurrentTargetColor"
        }) do
            if data[key] then Settings[key] = data[key] end
        end
        for _, key in ipairs({
            "TargetOutlineTransparency","TargetFillTransparency",
            "WhitelistOutlineTransparency","WhitelistFillTransparency"
        }) do
            if data[key] then Settings[key] = data[key] end
        end
        for _, key in ipairs({
            "TargetUseOutline","TargetUseFill","WhitelistUseOutline","WhitelistUseFill"
        }) do
            if data[key] ~= nil then Settings[key] = data[key] end
        end
    end
end

local function serializeList(list)
    local data = {}
    for _, entry in pairs(list) do
        if type(entry) == "table" and entry.Pending then
            table.insert(data, entry)
        elseif type(entry) == "userdata" then
            table.insert(data, { Name = entry.Name, UserId = entry.UserId, Pending = false })
        end
    end
    return data
end

local function deserializeList(data)
    local list = {}
    if type(data) ~= "table" then return list end
    for _, saved in pairs(data) do
        if saved.Pending then
            table.insert(list, saved)
        else
            local player = Players:FindFirstChild(saved.Name)
            if player then
                table.insert(list, player)
            else
                table.insert(list, { Name = saved.Name, UserId = saved.UserId, Pending = true })
            end
        end
    end
    return list
end

local function saveSelectedPlayers()
