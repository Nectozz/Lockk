local function hookCharacter(player)
    if player == LocalPlayer then return end

    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        task.wait(0.15)

        if isInList(selectedPlayers, player) then
            createAimDot(player)
            applyHighlight(player, true)
        elseif isInList(whitelistPlayers, player) then
            applyHighlight(player, false)
        end
    end

    player.CharacterAdded:Connect(onChar)
    if player.Character then
        task.spawn(onChar, player.Character)
    end
end

for _, player in pairs(Players:GetPlayers()) do
    hookCharacter(player)
end

Players.PlayerAdded:Connect(function(player)
    task.wait(0.1)

    for i, entry in pairs(selectedPlayers) do
        if isPendingPlayer(entry) and entry.UserId == player.UserId then
            selectedPlayers[i] = player
            break
        end
    end

    for i, entry in pairs(whitelistPlayers) do
        if isPendingPlayer(entry) and entry.UserId == player.UserId then
            whitelistPlayers[i] = player
            break
        end
    end

    hookCharacter(player)
    refreshPlayerList()
end)

Players.PlayerRemoving:Connect(function(player)
    for i, p in pairs(selectedPlayers) do
        if p == player then
            selectedPlayers[i] = { Name = player.Name, UserId = player.UserId, Pending = true }
            break
        end
    end
    for i, p in pairs(whitelistPlayers) do
        if p == player then
            whitelistPlayers[i] = { Name = player.Name, UserId = player.UserId, Pending = true }
            break
        end
    end

    removeAimDot(player)
    removePlayerHighlight(player)

    if currentTarget == player then currentTarget = nil end
    saveSelectedPlayers()
    saveWhitelist()
    refreshPlayerList()
end)

