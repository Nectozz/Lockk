end

-- ========== MAIN AIM LOOP через BindToRenderStep ==========
local AIM_BIND_NAME = "AimLockCamera"

local function aimStep()
    -- Обновляем Drawing-точки
    for _, entry in pairs(selectedPlayers) do
        if not isPendingPlayer(entry) and aimDots[entry] then
            updateAimDot(entry)
        end
    end

    if aimLockEnabled then
        -- Если текущая цель пропала/мертва/в WL — ищем нового (таргет или ближайший, кроме WL)
        if not currentTarget
            or not isPlayerAlive(currentTarget)
            or isWhitelisted(currentTarget)
            or not getTargetPart(currentTarget.Character) then
            currentTarget = getAimTarget()
        end

        if currentTarget then
            local part = getTargetPart(currentTarget.Character)
            if part then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                if Settings.AimSensitivity >= 1 then
                    Camera.CFrame = targetCFrame
                else
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Settings.AimSensitivity)
                end
            end
        end
    end

    updateStatus()
end

RunService:UnbindFromRenderStep(AIM_BIND_NAME)
RunService:BindToRenderStep(AIM_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, aimStep)

