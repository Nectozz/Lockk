local function refreshPlayerList()
    for _, child in pairs(scrollingFrame:GetChildren()) do
        if child:IsA("ImageButton") then child:Destroy() end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local isTarget = isInList(selectedPlayers, player)
        local isWL = isInList(whitelistPlayers, player)

        local btn = Instance.new("ImageButton")
        btn.Name = "Player_" .. player.Name
        btn.Size = UDim2.new(0, 80, 0, 90)
        if isWL then
            btn.BackgroundColor3 = Color3.fromRGB(0, 90, 160)
        elseif isTarget then
            btn.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
        else
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        end
        btn.BackgroundTransparency = 0.2
        btn.BorderSizePixel = 0
        btn.ClipsDescendants = true
        btn.Active = true
        btn.AutoButtonColor = false
        btn.Parent = scrollingFrame
        btn.Image = getAvatarUrl(player.UserId)
        Instance.new("UICorner").CornerRadius = UDim.new(0, 8); Instance.new("UICorner").Parent = btn

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "Name"
        nameLabel.Size = UDim2.new(1, 0, 0, 18)
        nameLabel.Position = UDim2.new(0, 0, 1, -18)
        nameLabel.BackgroundColor3 = Color3.fromRGB(0,0,0)
        nameLabel.BackgroundTransparency = 0.4
        nameLabel.Text = player.DisplayName or player.Name
        nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
        nameLabel.TextSize = 10
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        nameLabel.Active = false
        nameLabel.Parent = btn

        if isTarget or isWL then
            local ind = Instance.new("Frame")
            ind.Name = "Indicator"
            ind.Size = UDim2.new(0, 8, 0, 8)
            ind.Position = UDim2.new(1, -12, 0, 4)
            ind.BackgroundColor3 = isWL and Color3.fromRGB(40,120,255) or Color3.fromRGB(255,40,40)
            ind.BorderSizePixel = 0
            ind.Active = false
            ind.Parent = btn
            Instance.new("UICorner").CornerRadius = UDim.new(1, 0); Instance.new("UICorner").Parent = ind
        end

        btn.MouseEnter:Connect(function()
            hoveredListPlayer = player
        end)
        btn.MouseLeave:Connect(function()
            if hoveredListPlayer == player then hoveredListPlayer = nil end
        end)

        local function onPlayerButtonClick()
            if isInList(selectedPlayers, player) then
                removeFromList(selectedPlayers, player)
                removeAimDot(player)
                if not isInList(whitelistPlayers, player) then
                    removePlayerHighlight(player)
                else
                    applyHighlight(player, false)
                end
                if currentTarget == player then currentTarget = nil end
            else
                if isInList(whitelistPlayers, player) then
                    removeFromList(whitelistPlayers, player)
                    saveWhitelist()
                end
                table.insert(selectedPlayers, player)
                createAimDot(player)
                applyHighlight(player, true)
            end
            saveSelectedPlayers()
            refreshPlayerList()
        end

        btn.MouseButton1Click:Connect(onPlayerButtonClick)
        nameLabel.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                onPlayerButtonClick()
            end
        end)
    end

    task.wait()
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, gridLayout.AbsoluteContentSize.Y + 10)
end

